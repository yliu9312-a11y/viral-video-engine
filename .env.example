# VST Docker Environment Variables
# Copy to .env and fill in values before running docker compose

# Gemini API key for AIGC image generation (Strategy D)
# Leave empty to skip image generation
GEMINI_API_KEY=

# Gemini image model
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# MiMo API (OpenAI-compatible endpoint)
MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/v1/chat/completions
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro

# MiMo VLM model (for S1 scene understanding + S3 material tagging)
MIMO_VLM_MODEL=mimo-v2.5

# Whisper ASR model size (small/medium/large, default: small)
ASR_MODEL_SIZE=small
